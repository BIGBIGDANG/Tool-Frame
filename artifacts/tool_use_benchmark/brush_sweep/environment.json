{
  "schema_version": "toolframe_benchmark_environment_v1",
  "project_root": "${TOOLFRAME_ROOT}",
  "setup_command": "cd ${TOOLFRAME_ROOT} && bin/toolframe bootstrap-env",
  "env_check_command": "bin/toolframe env-check --mode core",
  "runtime_paths": {
    "core_venv": "${TOOLFRAME_ROOT}/.venv_parttoolgen_py38",
    "isaacgym": "${TOOLFRAME_ROOT}/artifacts/third_party/isaacgym/python",
    "pretrained_policy_root": "${TOOLFRAME_ROOT}/pretrained_policy",
    "simtoolreal_site": "${TOOLFRAME_ROOT}/.venv_simtoolreal/lib/python3.8/site-packages"
  },
  "runner": "parttoolgen/src/parttoolgen/cli/runners/run_image_grounded_brush_seed_eval.py",
  "notes": [
    "ToolFrame_6.4 owns the cleaned source/config tree.",
    "Use .parttoolgen.local.env only for explicit local fallback runtime dependencies while large artifacts are being packaged.",
    "Use bin/toolframe for public handoff commands; the runner field is registry metadata."
  ]
}
