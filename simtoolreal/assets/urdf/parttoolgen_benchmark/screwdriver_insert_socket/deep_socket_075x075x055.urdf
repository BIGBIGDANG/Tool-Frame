<?xml version="1.0"?>
<robot name="parttoolgen_screwdriver_insert_thin_guide_socket">
  <link name="thin_guide_socket">
    <!-- Public tabletop insertion target: a small visual base plus a thin-wall
         guide sleeve. The guide hole is 8 mm across, slightly larger than the
         long_screwdriver shaft/tip diameter measured from the public mesh. -->
    <visual>
      <material name="guide_socket_gray">
        <color rgba="0.50 0.50 0.50 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="thin_guide_socket_036x055.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual>
      <material name="guide_socket_dark_visible_bottom">
        <color rgba="0.015 0.015 0.015 1.0"/>
      </material>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0035" length="0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.005 0 0.0275"/>
      <geometry>
        <box size="0.002 0.012 0.055"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.005 0 0.0275"/>
      <geometry>
        <box size="0.002 0.012 0.055"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.005 0.0275"/>
      <geometry>
        <box size="0.008 0.002 0.055"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.005 0.0275"/>
      <geometry>
        <box size="0.008 0.002 0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00003" ixy="0.0" ixz="0.0" iyy="0.00003" iyz="0.0" izz="0.00003"/>
    </inertial>
  </link>
</robot>
