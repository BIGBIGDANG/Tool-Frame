# Local runtime overrides for ToolFrame_6.4.
#
# Keep secrets out of git. Copy this file to `.parttoolgen.local.env` only when
# a machine needs explicit paths that are not discoverable from this checkout.
# The default fresh-clone path is:
#
#   bin/toolframe bootstrap-env
#   bin/toolframe env-check --mode core
#
# Equivalent manual install:
#
#   python -m pip install -r requirements.txt
#
# Project-local examples:
#
# export PARTTOOLGEN_CORE_VENV="${PARTTOOLGEN_ROOT}/.venv_parttoolgen_py38"
# export PARTTOOLGEN_ISAACGYM="${PARTTOOLGEN_ROOT}/artifacts/third_party/isaacgym/python"
# export PARTTOOLGEN_SIMTOOLREAL_SITE="${PARTTOOLGEN_ROOT}/.venv_simtoolreal/lib/python3.8/site-packages"
# export PARTTOOLGEN_PRETRAINED_POLICY_ROOT="${PARTTOOLGEN_ROOT}/pretrained_policy"
#
# Optional temporary fallback while packaging runtime artifacts locally:
#
# export PARTTOOLGEN_LEGACY_515_ROOT="/abs/path/to/PartCentricAffordanceProgram_5.15"
# export PARTTOOLGEN_ISAACGYM="${PARTTOOLGEN_LEGACY_515_ROOT}/artifacts/third_party/isaacgym/python"
# export PARTTOOLGEN_SIMTOOLREAL_SITE="${PARTTOOLGEN_LEGACY_515_ROOT}/.venv_simtoolreal/lib/python3.8/site-packages"
# export PARTTOOLGEN_PRETRAINED_POLICY_ROOT="${PARTTOOLGEN_LEGACY_515_ROOT}/pretrained_policy"
#
# Optional VLM credentials:
#
# export OPENAI_API_KEY="..."
# export VLM_API_BASE="..."
# export VLM_MODEL="..."
