{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_part_graph.schema.json",
  "title": "ToolPartGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_frame",
    "parts",
    "relations",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "tool_id": { "type": "string", "minLength": 1 },
    "tool_frame": { "const": "tool" },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/part" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "geometry_mode", "segmentation_mode"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "geometry_mode": {
          "type": "string",
          "enum": ["observed", "prior", "mixed"]
        },
        "segmentation_mode": {
          "type": "string",
          "enum": [
            "sampart3d",
            "grounded_sam_part",
            "observed_tool_crop",
            "mesh_prior_adapter",
            "mixed"
          ]
        },
        "notes": { "type": "string" },
        "part_semantic_labels": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observation_id", "method"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source_artifact": { "type": "string" }
      }
    },
    "obb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center_xyz_tool", "extent_xyz", "axes_tool"],
      "properties": {
        "center_xyz_tool": { "$ref": "#/$defs/vec3" },
        "extent_xyz": { "$ref": "#/$defs/vec3" },
        "axes_tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "$ref": "#/$defs/vec3" },
            "y": { "$ref": "#/$defs/vec3" },
            "z": { "$ref": "#/$defs/vec3" }
          }
        }
      }
    },
    "surface_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_hint", "center_xyz_tool", "normal_tool", "confidence", "source", "provenance"],
      "properties": {
        "role_hint": { "type": "string", "minLength": 1 },
        "center_xyz_tool": { "$ref": "#/$defs/vec3" },
        "normal_tool": { "$ref": "#/$defs/vec3" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "role_candidates",
        "mask_ref",
        "point_count",
        "centroid_xyz_tool",
        "obb",
        "confidence",
        "source",
        "provenance"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "source_label": { "type": "string" },
        "semantic_label": { "type": "string", "minLength": 1 },
        "semantic_aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_description": { "type": "string" },
        "semantic_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "semantic_evidence_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_source": { "type": "string" },
        "role_candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mask_ref": { "type": "string", "minLength": 1 },
        "point_count": { "type": "integer", "minimum": 1 },
        "centroid_xyz_tool": { "$ref": "#/$defs/vec3" },
        "obb": { "$ref": "#/$defs/obb" },
        "surface_patches": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/surface_patch" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject", "object"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "object": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
