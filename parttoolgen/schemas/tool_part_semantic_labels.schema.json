{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parttoolgen.local/schemas/tool_part_semantic_labels.schema.json",
  "title": "ToolPartSemanticLabels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "label_id", "tool_id", "parts", "metadata"],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "label_id": { "type": "string", "minLength": 1 },
    "tool_id": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/part_label" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["created_by", "mode"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "mode": {
          "enum": [
            "vlm_part_semantic_aliases",
            "provider_supplied_part_semantic_aliases",
            "deterministic_unlabeled_scaffold"
          ]
        },
        "model": { "type": "string" },
        "prompt_path": { "type": "string" },
        "raw_response_path": { "type": "string" }
      }
    }
  },
  "$defs": {
    "part_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_ref",
        "semantic_label",
        "aliases",
        "visual_description",
        "confidence",
        "evidence_items",
        "source",
        "provenance"
      ],
      "properties": {
        "part_ref": { "type": "string", "pattern": "^tool\\.parts\\.[A-Za-z_][A-Za-z0-9_]*$" },
        "semantic_label": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "visual_description": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "required": ["method", "observation_id"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "observation_id": { "type": "string", "minLength": 1 },
            "source_artifact": { "type": "string" }
          }
        }
      }
    }
  }
}
