{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner_program.schema.json",
  "title": "PlannerProgram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "task_instruction",
    "language",
    "entrypoint",
    "allowed_api_version",
    "program_text",
    "safety_contract",
    "generation_metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "program_id": { "type": "string", "minLength": 1 },
    "task_instruction": { "type": "string", "minLength": 1 },
    "language": { "const": "python" },
    "entrypoint": { "const": "build_program" },
    "allowed_api_version": {
      "enum": ["parttoolgen_program_api_v0.2", "parttoolgen_program_api_v0.3"]
    },
    "program_text": { "type": "string", "minLength": 1 },
    "declared_symbol_table": { "type": "object", "additionalProperties": true },
    "safety_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ast_checked",
        "restricted_builtins",
        "imports_allowed",
        "io_allowed",
        "network_allowed"
      ],
      "properties": {
        "ast_checked": { "type": "boolean" },
        "restricted_builtins": { "type": "boolean" },
        "imports_allowed": { "const": false },
        "io_allowed": { "const": false },
        "network_allowed": { "const": false }
      }
    },
    "generation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "mode"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "mode": { "const": "vlm_authored_python" },
        "model": { "type": "string" },
        "prompt_id": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
