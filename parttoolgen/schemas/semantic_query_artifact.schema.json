{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_query_artifact.schema.json",
  "title": "SemanticQueryArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_artifact_id",
    "observation_id",
    "task_instruction",
    "queries",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "query_artifact_id": { "type": "string", "minLength": 1 },
    "observation_id": { "type": "string", "minLength": 1 },
    "task_instruction": { "type": "string", "minLength": 1 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/query" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["created_by", "mode"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "mode": { "const": "vlm_authored_semantic_queries" },
        "model": { "type": "string" },
        "prompt_hash": { "type": "string" },
        "raw_response_path": { "type": "string" }
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query_string",
        "scope",
        "roles",
        "expected_geometry",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "query_string": { "type": "string", "minLength": 1, "maxLength": 160 },
        "scope": {
          "type": "string",
          "enum": ["scene", "tool", "target", "candidate"]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "expected_geometry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["object", "part", "point", "axis", "region", "surface"]
          }
        },
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
        "category_hint": {
          "type": "string",
          "enum": ["object", "tool_part", "functional_tool_part", "target_part"]
        },
        "functional": { "type": "boolean" },
        "semantic_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  }
}
