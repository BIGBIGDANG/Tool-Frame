{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program_ir.schema.json",
  "title": "PartToolGenProgramIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "task_instruction",
    "api_version",
    "stages",
    "constraints",
    "objectives",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "program_id": { "type": "string", "minLength": 1 },
    "task_instruction": { "type": "string", "minLength": 1 },
    "api_version": {
      "enum": ["parttoolgen_program_api_v0.2", "parttoolgen_program_api_v0.3"]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "repeat": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "type", "refs", "params", "hard"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "contact",
              "distance",
              "align_axis",
              "align_vector_between_points",
              "pre_contact_offset",
              "clearance",
              "move_along",
              "approach_corridor",
              "tool_occupancy_clearance"
            ]
          },
          "refs": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "params": { "type": "object", "additionalProperties": true },
          "hard": { "type": "boolean" },
          "weight": { "type": "number", "minimum": 0 },
          "source": { "type": "string" }
        },
        "allOf": [
        {
          "if": { "properties": { "type": { "const": "contact" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "target"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "target": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tolerance_m"],
                "properties": {
                  "tolerance_m": { "type": "number", "minimum": 0, "maximum": 0.5 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "distance" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["a", "b"],
                "properties": {
                  "a": { "type": "string", "minLength": 1 },
                  "b": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target_m", "tolerance_m"],
                "properties": {
                  "target_m": { "type": "number", "minimum": 0, "maximum": 5 },
                  "tolerance_m": { "type": "number", "minimum": 0, "maximum": 0.5 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "align_axis" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_axis", "target_axis"],
                "properties": {
                  "source_axis": { "type": "string", "minLength": 1 },
                  "target_axis": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["polarity", "min_cosine"],
                "properties": {
                  "polarity": { "enum": ["same", "opposite", "auto"] },
                  "min_cosine": { "type": "number", "minimum": -1, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "align_vector_between_points" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_start", "source_end", "target_axis"],
                "properties": {
                  "source_start": { "type": "string", "minLength": 1 },
                  "source_end": { "type": "string", "minLength": 1 },
                  "target_axis": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["polarity", "min_cosine"],
                "properties": {
                  "polarity": { "enum": ["same", "opposite", "auto"] },
                  "min_cosine": { "type": "number", "minimum": -1, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pre_contact_offset" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "target", "axis"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "target": { "type": "string", "minLength": 1 },
                  "axis": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["distance_m", "direction"],
                "properties": {
                  "distance_m": { "type": "number", "minimum": 0, "maximum": 5 },
                  "direction": { "enum": ["opposite_axis", "along_axis"] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "clearance" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["moving", "obstacle"],
                "properties": {
                  "moving": { "type": "string", "minLength": 1 },
                  "obstacle": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_distance_m"],
                "properties": {
                  "min_distance_m": { "type": "number", "minimum": 0, "maximum": 5 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "move_along" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "start", "end"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "start": { "type": "string", "minLength": 1 },
                  "end": { "type": "string", "minLength": 1 },
                  "swing_axis": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile": { "enum": ["linear", "swing_arc"] },
                  "path_family": { "enum": ["contact_follow", "slide", "swing"] },
                  "swing_angle_rad": { "type": "number", "minimum": 0.01, "maximum": 1.57 },
                  "swing_lift_m": { "type": "number", "minimum": 0, "maximum": 0.25 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "approach_corridor" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "start", "goal"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "start": { "type": "string", "minLength": 1 },
                  "goal": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["radius_m", "samples"],
                "properties": {
                  "radius_m": { "type": "number", "minimum": 0, "maximum": 1 },
                  "samples": { "type": "integer", "minimum": 2, "maximum": 32 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tool_occupancy_clearance" } } },
          "then": {
            "properties": {
              "refs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool_part", "obstacle"],
                "properties": {
                  "tool_part": { "type": "string", "minLength": 1 },
                  "obstacle": { "type": "string", "minLength": 1 }
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_distance_m", "samples"],
                "properties": {
                  "min_distance_m": { "type": "number", "minimum": 0, "maximum": 1 },
                  "samples": {
                    "enum": ["centroid", "obb_corners", "surface_patch_centers"]
                  }
                }
              }
            }
          }
        }
        ]
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "kind", "function_name", "weight", "refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["subgoal", "path"] },
          "function_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "source": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ast_checked", "executed"],
      "properties": {
        "ast_checked": { "type": "boolean" },
        "executed": { "type": "boolean" }
      }
    }
  }
}
