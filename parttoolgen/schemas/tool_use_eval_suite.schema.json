{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parttoolgen.tool_use_eval_suite.v0",
  "title": "PartToolGen Tool-Use Evaluation Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "parttoolgen_tool_use_eval_suite_v0"},
    "suite_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_path"],
        "additionalProperties": false,
        "properties": {
          "task_path": {"type": "string", "minLength": 1},
          "split": {"type": "string"},
          "enabled": {"type": "boolean", "default": true}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
