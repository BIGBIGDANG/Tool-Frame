{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_contract.schema.json",
  "title": "PartToolGenProviderContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "provider_id",
    "provider_type",
    "source_kind",
    "deployable",
    "oracle",
    "capabilities",
    "frame_contracts",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "provider_id": { "type": "string", "minLength": 1 },
    "provider_type": {
      "type": "string",
      "enum": [
        "perception",
        "tool_prior",
        "environment",
        "execution_feedback",
        "simulation"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "OBSERVED_RGBD",
        "MODEL_MASK",
        "MODEL_SEMANTIC",
        "REGISTRATION_PRIOR",
        "MESH_PRIOR",
        "TRACKED_POSE",
        "MARKER_OR_MOCAP",
        "ENVIRONMENT_CONFIG",
        "SIMULATOR_ORACLE_DEBUG"
      ]
    },
    "deployable": { "type": "boolean" },
    "oracle": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "rgbd",
          "segmentation",
          "mask_tracking",
          "pose_tracking",
          "tool_functional_parts",
          "target_geometry",
          "sdf",
          "collision_geometry",
          "execution_feedback",
          "environment_setup"
        ]
      }
    },
    "frame_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "temporary_observed_tool_frame",
          "registered_tool_frame",
          "simtoolreal_asset_root",
          "debug_oracle_asset_root",
          "world_scene_frame",
          "target_local_frame"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "source_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "calibration_chain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "timestamp_or_capture_id": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
