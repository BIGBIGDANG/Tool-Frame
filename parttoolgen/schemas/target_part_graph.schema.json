{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target_part_graph.schema.json",
  "title": "TargetPartGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "target_id",
    "frame",
    "parts",
    "axes",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "graph_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "frame": { "const": "world" },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/part" }
    },
    "axes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/axis" }
    },
    "relations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["created_by", "geometry_mode"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "geometry_mode": {
          "type": "string",
          "enum": ["observed", "mixed"]
        },
        "segmentation_mode": { "type": "string" },
        "observation_bundle": { "type": "string" }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["confidence", "source", "provenance"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "required": ["observation_id", "method"],
          "properties": {
            "observation_id": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "source_artifact": { "type": "string" }
          }
        }
      }
    },
    "patch": {
      "allOf": [
        { "$ref": "#/$defs/grounding" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["patch_ref", "role_hint", "center_xyz_world", "normal_world"],
          "properties": {
            "patch_ref": { "type": "string", "minLength": 1 },
            "role_hint": { "type": "string", "minLength": 1 },
            "center_xyz_world": { "$ref": "#/$defs/vec3" },
            "normal_world": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "part": {
      "allOf": [
        { "$ref": "#/$defs/grounding" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["part_ref", "label", "role_candidates", "surface_patches"],
          "properties": {
            "part_ref": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "object_ref": { "type": "string" },
            "mask_ref": { "type": "string" },
            "role_candidates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "surface_patches": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/patch" }
            }
          }
        }
      ]
    },
    "axis": {
      "allOf": [
        { "$ref": "#/$defs/grounding" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["axis_ref", "vector_world"],
          "properties": {
            "axis_ref": { "type": "string", "minLength": 1 },
            "object_ref": { "type": "string" },
            "vector_world": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    }
  }
}
