{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_pose_subgoals.schema.json",
  "title": "PartToolGenToolPoseSubgoals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subgoals_id",
    "tool_id",
    "task_id",
    "world_frame",
    "units",
    "quaternion_order",
    "start_pose",
    "goals",
    "source_trace",
    "sanity_checks",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.2" },
    "subgoals_id": { "type": "string", "minLength": 1 },
    "tool_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "world_frame": { "const": "world" },
    "units": { "const": "meters" },
    "quaternion_order": { "const": "xyzw" },
    "start_pose": { "$ref": "#/$defs/pose" },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/goal" }
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_scene_graph",
        "grounding_candidates",
        "functional_tool_parts",
        "planner_program",
        "program_ir"
      ],
      "properties": {
        "observed_scene_graph": { "$ref": "#/$defs/artifact_ref" },
        "grounding_candidates": { "$ref": "#/$defs/artifact_ref" },
        "functional_tool_parts": { "$ref": "#/$defs/artifact_ref" },
        "planner_program": { "$ref": "#/$defs/artifact_ref" },
        "program_ir": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "sanity_checks": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "source", "geometry_mode"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "geometry_mode": {
          "type": "string",
          "enum": ["observed", "mixed"]
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation_xyzw"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "orientation_xyzw": { "$ref": "#/$defs/quat" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "stage",
        "pose_world_tool",
        "duration_sec",
        "tolerance",
        "source_constraints",
        "expected_contact",
        "functional_goal"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "stage": { "type": "string", "minLength": 1 },
        "semantic_gate": { "type": "boolean" },
        "semantic_role": { "type": "string", "minLength": 1 },
        "pose_world_tool": { "$ref": "#/$defs/pose" },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position_m", "rotation_rad"],
          "properties": {
            "position_m": { "type": "number", "minimum": 0 },
            "rotation_rad": { "type": "number", "minimum": 0 }
          }
        },
        "source_constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_part", "scene_target"],
          "properties": {
            "tool_part": { "type": "string", "minLength": 1 },
            "scene_target": { "type": "string", "minLength": 1 },
            "allow_contact_penetration": { "type": "boolean" }
          }
        },
        "functional_goal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part_ref", "position_world", "orientation_xyzw"],
          "properties": {
            "part_ref": { "type": "string", "minLength": 1 },
            "position_world": { "$ref": "#/$defs/vec3" },
            "orientation_xyzw": { "$ref": "#/$defs/quat" }
          }
        }
      }
    }
  }
}
