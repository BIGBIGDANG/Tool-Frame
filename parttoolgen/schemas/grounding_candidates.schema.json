{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grounding_candidates.schema.json",
  "title": "GroundingCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grounding_id",
    "observation_id",
    "frames",
    "marks",
    "points",
    "regions",
    "axes",
    "surfaces",
    "parts",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "v0.1" },
    "grounding_id": { "type": "string", "minLength": 1 },
    "observation_id": { "type": "string", "minLength": 1 },
    "frames": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "marks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/mark" }
    },
    "points": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/point" }
    },
    "regions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/region" }
    },
    "axes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/axis" }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/surface" }
    },
    "parts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/part" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["created_by", "grounding_mode"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "grounding_mode": {
          "type": "string",
          "enum": ["model_grounded", "model_grounded_with_prior", "mixed"]
        },
        "task_instruction": { "type": "string" }
      }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observation_id", "method"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source_artifact": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": true,
      "required": ["label", "confidence", "source", "provenance"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "candidate_type": { "type": "string", "minLength": 1 },
        "object_ref": { "type": "string" },
        "part_ref": { "type": "string" },
        "mask_ref": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "mark": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["pixel"],
          "properties": {
            "pixel": { "$ref": "#/$defs/vec2" }
          }
        }
      ]
    },
    "point": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "pixel": { "$ref": "#/$defs/vec2" },
            "xyz_world": { "$ref": "#/$defs/vec3" },
            "xyz_tool": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "region": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "center_xyz_world": { "$ref": "#/$defs/vec3" },
            "center_xyz_tool": { "$ref": "#/$defs/vec3" },
            "extent_xyz": { "$ref": "#/$defs/vec3" },
            "extent_xyz_tool": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "axis": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "vector_world": { "$ref": "#/$defs/vec3" },
            "vector_tool": { "$ref": "#/$defs/vec3" },
            "origin_xyz_world": { "$ref": "#/$defs/vec3" },
            "origin_xyz_tool": { "$ref": "#/$defs/vec3" }
          },
          "anyOf": [
            { "required": ["vector_world"] },
            { "required": ["vector_tool"] }
          ]
        }
      ]
    },
    "surface": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "point_xyz_world": { "$ref": "#/$defs/vec3" },
            "point_xyz_tool": { "$ref": "#/$defs/vec3" },
            "normal_world": { "$ref": "#/$defs/vec3" },
            "normal_tool": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "part": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "role_candidates": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
