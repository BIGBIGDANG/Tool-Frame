{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parttoolgen.target_scene_visual_evidence.v0",
  "title": "PartToolGen Target Scene Visual Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "task_id",
    "instruction",
    "items",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "parttoolgen_target_scene_visual_evidence_v0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "path"],
        "additionalProperties": true,
        "properties": {
          "kind": {"const": "target_scene_overview"},
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["candidate_marker_table", "prompt_images", "candidate_count"],
      "additionalProperties": true,
      "properties": {
        "candidate_marker_table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["marker", "target_ref"],
            "additionalProperties": true,
            "properties": {
              "marker": {"type": "string", "pattern": "^T[0-9]+$"},
              "target_ref": {"type": "string", "minLength": 1},
              "contact_refs": {"type": "array", "items": {"type": "string"}},
              "axis_refs": {"type": "array", "items": {"type": "string"}},
              "pre_contact_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "prompt_images": {"type": "array", "items": {"type": "string"}},
        "candidate_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
