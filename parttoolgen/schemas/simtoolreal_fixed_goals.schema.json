{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simtoolreal_fixed_goals.schema.json",
  "title": "SimToolRealFixedGoals",
  "type": "object",
  "additionalProperties": false,
  "required": ["start_pose", "goals", "metadata"],
  "properties": {
    "start_pose": { "$ref": "#/$defs/pose7" },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pose7" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_subgoals_id",
        "target_api",
        "coordinate_frame",
        "units",
        "quaternion_order",
        "generated_by"
      ],
      "properties": {
        "schema_version": { "const": "v0.1" },
        "source_subgoals_id": { "type": "string", "minLength": 1 },
        "target_api": { "const": "fixed_goal_states_json" },
        "coordinate_frame": { "const": "world" },
        "units": { "const": "meters" },
        "quaternion_order": { "const": "xyzw" },
        "generated_by": { "const": "parttoolgen_simtoolreal_adapter" },
        "start_goal_in_fixed_goals": { "type": "boolean" },
        "task_terminal_source_goal_index": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "task_terminal_stage": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "skipped_initial_goals": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceGoalNote" }
        },
        "truncated_post_terminal_goals": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceGoalNote" }
        },
        "goal_index_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixed_goal_index", "source_goal_index", "stage", "source"],
            "properties": {
              "fixed_goal_index": { "type": "integer", "minimum": 0 },
              "source_goal_index": {
                "anyOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "stage": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceGoalNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_goal_index", "stage", "reason"],
      "properties": {
        "source_goal_index": { "type": "integer", "minimum": 0 },
        "stage": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "pose7": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "number" }
    }
  }
}
