{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parttoolgen.local/schemas/visual_diagnosis_report.schema.json",
  "title": "VisualDiagnosisReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "diagnosis_category",
    "observations",
    "evidence_items",
    "related_refs",
    "repair_hints",
    "confidence",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "v0.1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_category": {
      "enum": [
        "no_visual_failure_observed",
        "wrong_function_region",
        "wrong_function_point",
        "wrong_target_contact",
        "orientation_relation_missing",
        "orientation_relation_wrong",
        "path_collision_or_occlusion",
        "tracking_or_execution_failure",
        "insufficient_visual_evidence",
        "unknown"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repair_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
